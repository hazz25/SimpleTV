<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/login_title"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabFree"
                    style="@style/Btn"
                    android:text="Gratuit" />

                <TextView
                    android:id="@+id/tabXtream"
                    style="@style/Btn"
                    android:text="Code Xtream" />

                <TextView
                    android:id="@+id/tabM3u"
                    style="@style/Btn"
                    android:text="Lien M3U" />
            </LinearLayout>

            <TextView
                android:id="@+id/fromPhone"
                style="@style/Btn"
                android:layout_marginTop="10dp"
                android:text="📱  Saisir depuis mon téléphone (QR code)"
                android:textColor="@color/gold" />

            <TextView
                android:id="@+id/help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="@string/login_help"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/name"
                style="@style/Field"
                android:hint="Nom de la liste (facultatif)"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="text" />

            <EditText
                android:id="@+id/m3uUrl"
                style="@style/Field"
                android:hint="Adresse de la liste (http://…/liste.m3u)"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textUri"
                android:visibility="gone" />

            <EditText
                android:id="@+id/server"
                style="@style/Field"
                android:hint="@string/server_hint"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/user"
                style="@style/Field"
                android:hint="@string/user_hint"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="text" />

            <EditText
                android:id="@+id/pass"
                style="@style/Field"
                android:hint="@string/pass_hint"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="text" />

            <TextView
                android:id="@+id/connect"
                style="@style/Btn"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="0dp"
                android:text="@string/connect" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
